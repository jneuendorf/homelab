---
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { repoBlobUrl, withBase, DEFAULT_LOCALE } from '../../consts';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  // Defined inside getStaticPaths: Astro extracts this into an isolated chunk that only
  // carries the module's imports, not other top-level declarations.
  // git decides what is source: tracked + untracked-but-not-ignored, so node_modules/, dist/
  // and host-local secrets (.env, dashboard.local.ts) never become pages.
  const files = execFileSync(
    'git',
    ['ls-files', '--cached', '--others', '--exclude-standard', 'scripts', 'config', 'projects'],
    { encoding: 'utf-8' },
  )
    .split('\n')
    .filter((rel) => rel && fs.existsSync(rel));
  return files.map((rel) => ({ params: { path: rel }, props: { rel } }));
}

const { rel } = Astro.props as { rel: string };
const raw = fs.readFileSync(path.resolve(process.cwd(), rel), 'utf-8').replace(/\n+$/, '');
const ext = rel.split('.').pop() ?? '';
const lang =
  (
    {
      sh: 'bash',
      conf: 'ini',
      ini: 'ini',
      ts: 'ts',
      js: 'javascript',
      css: 'css',
      example: 'bash',
    } as Record<string, string>
  )[ext] ?? 'plaintext';
const t = ui[DEFAULT_LOCALE];
---

<BaseLayout title={rel} locale={DEFAULT_LOCALE}>
  <main class="source">
    <p class="source__back"><a href={withBase(`${DEFAULT_LOCALE}/`)}>← {t['source.back']}</a></p>
    <header class="source__head">
      <h1><code>{rel}</code></h1>
      <a class="source__gh" href={repoBlobUrl(rel)} target="_blank" rel="noopener"
        >{t['source.viewOnGithub']} ↗</a
      >
    </header>
    <Code
      code={raw}
      lang={lang as any}
      themes={{ light: 'github-light', dark: 'github-dark' }}
      wrap
    />
  </main>

  <style>
    .source {
      max-width: 60rem;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
    }
    .source__back {
      font-size: 0.9rem;
    }
    .source__head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
    }
    .source__head h1 {
      font-size: 1.1rem;
      margin: 0;
      word-break: break-all;
    }
    .source :global(pre) {
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 0.85rem;
      overflow-x: auto;
    }
  </style>
</BaseLayout>
