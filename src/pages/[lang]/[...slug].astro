---
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { LOCALES, type Locale } from '../../consts';
import { getDocsBySlug, resolveDoc } from '../../lib/docs';

export async function getStaticPaths() {
  const bySlug = await getDocsBySlug();
  const paths = [];
  for (const lang of LOCALES) {
    for (const slug of bySlug.keys()) {
      if (slug === 'index') continue; // handled by [lang]/index.astro
      const resolved = resolveDoc(bySlug, slug, lang);
      if (!resolved) continue;
      paths.push({
        params: { lang, slug },
        props: { entryId: resolved.entry.id, translated: resolved.translated },
      });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;
const { entryId, translated } = Astro.props as { entryId: string; translated: boolean };

const bySlug = await getDocsBySlug();
// re-resolve the exact entry we chose in getStaticPaths (by id)
let entry;
for (const variants of bySlug.values()) {
  for (const v of variants.values()) if (v.id === entryId) entry = v;
}
if (!entry) throw new Error(`Entry not found: ${entryId}`);
const { Content } = await render(entry);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={lang}
  slug={slug}
  translated={translated}
>
  <Content />
</DocLayout>
