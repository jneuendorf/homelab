---
import BaseLayout from './BaseLayout.astro';
import { withBase, type Locale } from '../consts';
import { getNav } from '../lib/docs';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  slug?: string;
  /** false when the page is showing default-locale content as a fallback. */
  translated?: boolean;
  /** headings of the current page (from Astro's render()), for the in-page TOC. */
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, locale, slug, translated = true, headings = [] } = Astro.props;
const { guide, projects } = await getNav(locale);
const sectionHeadings = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description} locale={locale} slug={slug}>
  <div class="layout">
    <aside class="sidebar">
      <p class="sidebar__label">{ui[locale]['nav.guide']}</p>
      <nav>
        <ol>
          {
            guide.map((item) => (
              <li>
                <a
                  href={withBase(`${locale}/${item.slug}`)}
                  aria-current={item.slug === slug ? 'page' : undefined}
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      {
        projects.length > 0 && (
          <>
            <p class="sidebar__label sidebar__label--projects">{ui[locale]['nav.projects']}</p>
            <nav>
              <ul>
                {projects.map((item) => (
                  <li>
                    <a
                      href={withBase(`${locale}/${item.slug}`)}
                      aria-current={item.slug === slug ? 'page' : undefined}
                    >
                      {item.title}
                    </a>
                    {item.slug === slug && sectionHeadings.length > 0 && (
                      <ul class="sidebar__toc">
                        {sectionHeadings.map((heading) => (
                          <li>
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </>
        )
      }
    </aside>
    <main class="content">
      {!translated && <p class="fallback">{ui[locale]['doc.fallback']}</p>}
      <article class="prose">
        <slot />
      </article>
    </main>
  </div>

  <style>
    .layout {
      display: grid;
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 2rem;
      max-width: 68rem;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
    }
    .sidebar {
      position: sticky;
      top: 4rem;
      align-self: start;
      height: max-content;
    }
    .sidebar__label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-dim);
      margin: 0 0 0.5rem;
    }
    .sidebar ol,
    .sidebar ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .sidebar ol {
      counter-reset: step;
    }
    .sidebar ol li {
      counter-increment: step;
    }
    .sidebar a {
      display: block;
      padding: 0.3rem 0.5rem;
      border-radius: 6px;
      text-decoration: none;
      color: var(--text-dim);
      font-size: 0.9rem;
    }
    .sidebar ol a::before {
      content: counter(step) '. ';
      color: var(--text-dim);
      opacity: 0.6;
    }
    .sidebar a:hover {
      background: var(--accent-soft);
    }
    .sidebar a[aria-current='page'] {
      color: var(--accent);
      font-weight: 600;
      background: var(--accent-soft);
    }
    .sidebar__label--projects {
      margin-top: 1.25rem;
    }
    .sidebar ul.sidebar__toc {
      margin: 0.15rem 0 0.4rem 0.6rem;
      padding-left: 0.5rem;
      border-left: 1px solid var(--border);
    }
    .sidebar__toc a {
      font-size: 0.82rem;
      padding: 0.2rem 0.5rem;
    }
    /* scrolled-to section: lighter than the active project (accent text, no background) */
    .sidebar__toc a[data-active] {
      color: var(--accent);
      font-weight: 500;
    }
    .fallback {
      margin: 0 0 1.5rem;
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: 6px;
      background: var(--accent-soft);
      font-size: 0.9rem;
    }
    .prose {
      max-width: var(--max);
    }
    .prose :global(h1) {
      font-size: 2rem;
      line-height: 1.2;
      margin: 0 0 0.5rem;
    }
    .prose :global(h2) {
      margin-top: 2.25rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--border);
    }
    .prose :global(h3) {
      margin-top: 1.75rem;
    }
    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin: 1.25rem 0;
    }
    .prose :global(th),
    .prose :global(td) {
      border: 1px solid var(--border);
      padding: 0.4rem 0.6rem;
      text-align: left;
      vertical-align: top;
    }
    .prose :global(th) {
      background: var(--code-bar-bg);
    }
    .prose :global(blockquote) {
      margin: 1.25rem 0;
      padding: 0.5rem 1rem;
      border-left: 3px solid var(--accent);
      background: var(--accent-soft);
      border-radius: 0 6px 6px 0;
    }
    .prose :global(:not(pre) > code) {
      background: var(--code-bg);
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      font-size: 0.88em;
    }
    .prose :global(pre) {
      padding: 0.85rem 0.9rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      overflow-x: auto;
    }
    @media (max-width: 46rem) {
      .layout {
        grid-template-columns: 1fr;
      }
      .sidebar {
        position: static;
      }
    }
  </style>

  <script>
    // Scroll-spy: highlight the sidebar TOC link for the section currently near the top.
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.sidebar__toc a').forEach((a) => {
      links.set(decodeURIComponent(a.hash.slice(1)), a);
    });
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length) {
      const visible = new Set<string>();
      let active: string | null = null;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          // first heading (document order) still in the top band; else keep the last
          const current = headings.find((h) => visible.has(h.id))?.id;
          if (current && current !== active) {
            if (active) links.get(active)?.removeAttribute('data-active');
            links.get(current)?.setAttribute('data-active', '');
            active = current;
          }
        },
        { rootMargin: '0px 0px -80% 0px' },
      );
      headings.forEach((h) => observer.observe(h));
    }
  </script>
</BaseLayout>
